# ─────────────────────────────────────────────────────────────────
# Facilita PrEP — variáveis de ambiente para desenvolvimento local
# Copie este arquivo para `.env` e ajuste se necessário.
# Os valores abaixo já funcionam com `docker compose up -d`.
# ─────────────────────────────────────────────────────────────────

# ── Banco de dados (MySQL local via Docker) ──────────────────────
DATABASE_URL=mysql://facilita:facilita@127.0.0.1:3306/facilita_prep

# ── Redis (filas BullMQ) ─────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ── Segurança (chaves locais — não usar em produção) ─────────────
JWT_SECRET=desenvolvimento_local_jwt_secret_minimo_32_caracteres_aqui
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CPF_HASH_SALT=desenvolvimento_local_cpf_salt_pelo_menos_32_caracteres

# ── Google OAuth ─────────────────────────────────────────────────
# Criar credenciais em: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=XXXXXXXXXX.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-XXXXXXXXXX
# Deve ser igual ao GOOGLE_CLIENT_ID (exposto ao frontend via Vite)
VITE_GOOGLE_CLIENT_ID=XXXXXXXXXX.apps.googleusercontent.com
OWNER_OPEN_ID=admin-local

# ── Storage S3 (MinIO local via Docker) ──────────────────────────
AWS_ACCESS_KEY_ID=facilitaminio
AWS_SECRET_ACCESS_KEY=facilitaminio
AWS_REGION=us-east-1
AWS_S3_BUCKET=facilita-uploads
AWS_S3_ENDPOINT=http://127.0.0.1:9000

# ── App URL (usado para links em e-mails e redirects) ────────────
APP_URL=http://localhost:3000

# ── Servidor ─────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Opcionais (deixe vazio para desenvolvimento visual) ──────────
# Configure depois se quiser testar pagamento, e-mail real, NFe etc.
GMAIL_USER=
GMAIL_APP_PASSWORD=

FOCUSNFE_TOKEN_HOMOLOGACAO=
FOCUSNFE_TOKEN_PRODUCAO=
FOCUSNFE_ENVIRONMENT=homologacao

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

BUILT_IN_FORGE_API_URL=https://api.anthropic.com
BUILT_IN_FORGE_API_KEY=

ZAPI_INSTANCE_ID=
ZAPI_TOKEN=

    "date-fns": "^4.1.0",
    "docx": "^9.6.1",
    "drizzle-orm": "^0.38.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "framer-motion": "^11.1.1",
    "helmet": "^7.1.0",
    "jose": "^5.2.4",
    "lucide-react": "^0.368.0",
    "multer": "^1.4.5-lts.1",

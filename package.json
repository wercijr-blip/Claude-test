{
  "name": "facilita-prep",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tsx watch --env-file=.env server/_core/index.ts\" \"vite\"",
    "build": "BUILD_TIMESTAMP=$(date -u +%Y-%m-%dT%H:%M:%SZ) pnpm --filter facilita-prep-web build && BUILD_TIMESTAMP=$(date -u +%Y-%m-%dT%H:%M:%SZ) vite build",
    "start": "tsx --import ./server/_core/instrument.ts --env-file=.env server/_core/index.ts",
    "start:prod": "tsx --import ./server/_core/instrument.ts server/_core/index.ts",
    "start:workers": "tsx --import ./server/_core/instrument.ts server/workers.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint server/ client/src/ --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "tsx server/seed.ts",
    "dev:services": "docker compose up -d",
    "dev:full": "pnpm dev:services && pnpm dev"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1050.0",
    "@aws-sdk/s3-request-presigner": "^3.1050.0",
    "@fontsource/cormorant-garamond": "^5.2.11",
    "@fontsource/dm-sans": "^5.2.8",
    "@hookform/resolvers": "^3.3.4",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@sentry/node": "^10.53.1",
    "@sentry/react": "^10.51.0",
    "@signpdf/placeholder-plain": "3.3.0",
    "@signpdf/signer-p12": "3.3.0",
    "@signpdf/signpdf": "3.3.0",
    "@signpdf/utils": "3.3.0",
    "@tanstack/react-query": "^5.100.14",
    "@trpc/client": "11.16.0",
    "@trpc/react-query": "11.16.0",
    "@trpc/server": "11.16.0",
    "bullmq": "^5.4.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "drizzle-orm": "0.45.2",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "file-type": "^22.0.1",
    "framer-motion": "^11.1.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jose": "5.10.0",
    "lucide-react": "^0.368.0",
    "multer": "^2.1.1",
    "mysql2": "^3.22.3",
    "node-forge": "^1.3.1",
    "otplib": "^13.4.0",
    "pdf-lib": "1.17.1",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.3.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.51.3",
    "react-international-phone": "^4.8.0",
    "resend": "^6.12.2",
    "tailwind-merge": "^2.2.2",
    "tsx": "^4.21.0",
    "web-vitals": "^5.2.0",
    "wouter": "^3.1.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "pino-pretty": "^13.1.3",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.12.5",
    "@types/node-forge": "^1.3.11",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "2.1.9",
    "concurrently": "^10.0.3",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.2.5",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.4.4",
    "vite": "^6.0.0",
    "vitest": "2.1.9"
  },
  "pnpm": {
    "overrides": {
      "crypto-js": "^4.2.0"
    }
  }
}

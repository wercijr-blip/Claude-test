{
  "name": "medscrita",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tsx watch --env-file=.env server/_core/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx --env-file=.env server/_core/index.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "format": "prettier --write .",
    "seed": "tsx --env-file=.env seed.ts"
  },

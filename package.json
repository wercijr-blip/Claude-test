{
  "name": "facilita-prep",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tsx watch --env-file=.env server/_core/index.ts\" \"vite\"",
    "build": "pnpm --filter facilita-prep-web build; vite build",
    "start": "tsx --env-file=.env server/_core/index.ts",
    "start:prod": "tsx server/_core/index.ts",
    "start:workers": "tsx server/workers.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.540.0",
    "@aws-sdk/s3-request-presigner": "^3.540.0",
    "@hookform/resolvers": "^3.3.4",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@sentry/node": "^10.51.0",
    "@sentry/react": "^10.51.0",
    "@signpdf/placeholder-plain": "^3.3.0",
    "@signpdf/signer-p12": "^3.3.0",
    "@signpdf/signpdf": "^3.3.0",
    "@signpdf/utils": "^3.3.0",
    "@tanstack/react-query": "^5.28.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "bullmq": "^5.4.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.38.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "file-type": "^22.0.1",
    "framer-motion": "^11.1.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jose": "^5.2.4",
    "lucide-react": "^0.368.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.9.4",
    "node-forge": "^1.3.1",
    "nodemailer": "^6.9.13",
    "otplib": "^13.4.0",
    "pdf-lib": "^1.17.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.51.3",
    "resend": "^6.12.2",
    "stripe": "^15.2.0",
    "tailwind-merge": "^2.2.2",
    "tsx": "^4.21.0",
    "wouter": "^3.1.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.5",
    "@types/node-forge": "^1.3.11",
    "@types/nodemailer": "^6.4.14",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.30.0",
    "prettier": "^3.2.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.4.4",
    "vite": "^6.0.0",
    "vitest": "^2.0.0"
  }
}

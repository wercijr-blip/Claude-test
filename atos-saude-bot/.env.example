# Evolution API (servidor WhatsApp)
EVOLUTION_URL=http://localhost:8080
EVOLUTION_API_KEY=
INSTANCE_NAME=atossaude
# OBRIGATÓRIO em produção: deve coincidir com o webhook secret configurado na Evolution API
EVOLUTION_WEBHOOK_SECRET=

# Google Calendar (Service Account JSON)
GOOGLE_SERVICE_ACCOUNT_PATH=./src/config/google-service-account.json

# Anthropic AI (Claude)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# App
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
# Origem permitida para CORS (URL do painel em produção)
PANEL_ORIGIN=https://seu-dominio.com
# JWT (obrigatório em produção — mínimo 32 caracteres)
JWT_SECRET=
# Chave de criptografia AES-256 para dados pessoais (LGPD)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PII_ENCRYPTION_KEY=

# Volume persistente para banco de dados e uploads (obrigatório no Railway)
# Configure em Railway: Volumes → Add Volume → Mount Path: /data
# Em dev: deixar em branco (usa a raiz do projeto)
DATA_DIR=

# Backup offsite para S3 (opcional — deixar em branco para desativar)
# Se configurado, cada backup diário é enviado para S3 após salvar localmente
AWS_BACKUP_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

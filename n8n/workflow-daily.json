        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-20250514\",\n  \"max_tokens\": 600,\n  \"messages\": [{\n    \"role\": \"user\",\n    \"content\": \"Você é um médico especialista em {{ $('Contexto da especialidade').item.json.medical_specialty }}.\\nResuma em português em 4-5 linhas o abstract abaixo para uso clínico prático.\\nEste artigo já foi citado {{ $json.total_notes_generated }} vez(es) na clínica.\\nEstruture assim:\\n🎯 Relevância clínica: (1 linha)\\n📋 O que o estudo mostrou: (2 linhas)\\n💊 Implicação prática: (1 linha)\\n📊 Nível de evidência: (se mencionado)\\nEspecialidade: {{ $('Contexto da especialidade').item.json.medical_specialty }}\\nSubtemas: {{ $('Contexto da especialidade').item.json.subtopics.join(', ') }}\\nAbstract: {{ $json.abstract }}\"\n  }]\n}",
        "options": {
          "response": { "response": { "responseFormat": "json" } }
        }
      },

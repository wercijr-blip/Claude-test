        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"_id\": \"Knowledge-{{ $('Contexto da especialidade').item.json.medical_specialty }}-{{ $('Contexto da especialidade').item.json.topic.toLowerCase().replace(/\\s+/g, '-') }}-{{ $now.format('yyyy-MM-dd') }}\",\n  \"content\": \"---\\ntags:\\n  - {{ $('Contexto da especialidade').item.json.medical_specialty.toLowerCase() }}\\n  - {{ $('Contexto da especialidade').item.json.specialty_category.toLowerCase() }}\\n  - evidência\\ndata: {{ $now.format('yyyy-MM-dd') }}\\norigem: MedScribe consulta #{{ $('Contexto da especialidade').item.json.consultationId }}\\nmedico_origem: {{ $('Contexto da especialidade').item.json.doctorName }}\\nspecialidade_medico: {{ $('Contexto da especialidade').item.json.doctorSpecialty }}\\npmid: {{ $json.pmid }}\\nzotero: {{ $json.zoteroItemKey }}\\n---\\n\\n# {{ $('Contexto da especialidade').item.json.topic }}\\n**Especialidade:** {{ $('Contexto da especialidade').item.json.medical_specialty }}\\n**Subtemas:** {{ $('Contexto da especialidade').item.json.subtopics.join(', ') }}\\n\\n## Resumo clínico\\n{{ $('Claude — resumo clínico').item.json.content[0].text }}\\n\\n## Artigos encontrados\\n- [{{ $json.title }}](https://pubmed.ncbi.nlm.nih.gov/{{ $json.pmid }})\\n  {{ $json.journal }} | {{ $json.year }}\\n  📎 Zotero: {{ $json.zoteroItemKey }}\\n  🔁 Citado {{ $json.total_notes_generated }}x na clínica\\n  PDF: {{ $json.pdfAvailable ? '✅' : '❌' }}\\n\\n## Conexões sugeridas\\n[[{{ $('Contexto da especialidade').item.json.medical_specialty }}]]\\n\\n---\\n*Médico origem: {{ $('Contexto da especialidade').item.json.doctorName }} ({{ $('Contexto da especialidade').item.json.doctorSpecialty }})*\\n*Gerado automaticamente — MedScribe Pipeline*\"\n}",
        "options": {
          "response": { "response": { "responseFormat": "json" } }
        }
      },

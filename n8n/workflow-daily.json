    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.zotero.org/users/{{ $env.ZOTERO_USER_ID }}/items",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Zotero-API-Key", "value": "={{ $env.ZOTERO_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "=[{\n  \"itemType\": \"journalArticle\",\n  \"title\": \"{{ $json.title }}\",\n  \"publicationTitle\": \"{{ $json.journal }}\",\n  \"date\": \"{{ $json.year }}\",\n  \"DOI\": \"{{ $json.doi }}\",\n  \"extra\": \"PMID: {{ $json.pmid }}\",\n  \"abstractNote\": \"{{ $json.abstract }}\",\n  \"tags\": [\n    { \"tag\": \"infectologia\" },\n    { \"tag\": \"{{ $('Contexto da especialidade').item.json.medical_specialty }}\" },\n    { \"tag\": \"medscribe-pipeline\" }\n  ],\n  \"collections\": [\"{{ $env.ZOTERO_COLLECTION_ID }}\"]\n}]",
        "options": {
          "response": { "response": { "responseFormat": "json" } }
        }
      },

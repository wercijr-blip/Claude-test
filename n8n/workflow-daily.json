        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"json\": {\n    \"pmid\": \"{{ $json.pmid }}\",\n    \"doi\": \"{{ $json.doi }}\",\n    \"title\": \"{{ $json.title }}\",\n    \"journal\": \"{{ $json.journal }}\",\n    \"year\": {{ $json.year }},\n    \"abstract\": \"{{ $json.abstract }}\",\n    \"zoteroItemKey\": \"{{ $('Zotero — salvar referência').item.json.successful['0'].key }}\",\n    \"pdfAvailable\": {{ $json.pdfAvailable }},\n    \"pdfUrl\": \"{{ $json.pdfUrl }}\"\n  }\n}",
        "options": {
          "response": { "response": { "responseFormat": "json" } }
        }

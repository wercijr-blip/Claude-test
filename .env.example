# ── Banco de dados (TiDB / MySQL 8) ──────────────────────────────
DATABASE_URL=mysql://usuario:senha@host:4000/medscrita?ssl={"rejectUnauthorized":true}

# ── Autenticação ──────────────────────────────────────────────────
# Mínimo 32 caracteres aleatórios
JWT_SECRET=troque_por_uma_string_aleatoria_de_pelo_menos_32_chars

# ── App ───────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
VITE_APP_ID=medscrita

# URL do frontend (usada em CORS e e-mails)
MEDSCRIBE_URL=https://medscrita.com.br
MEDSCRIBE_CLINIC_NAME=MedScrita Clínica

# ── E-mail via SendGrid ───────────────────────────────────────────
SENDGRID_API_KEY=SG.xxxx
BULLETIN_FROM_EMAIL=noreply@medscrita.com.br
BULLETIN_FROM_NAME=MedScrita — Meu Conhecimento

# ── OpenAI (transcrição de áudio + geração de SOAP) ──────────────
OPENAI_API_KEY=sk-...

# ── AWS S3 (armazenamento de áudios) ─────────────────────────────
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=xxxx
AWS_REGION=us-east-1
AWS_S3_BUCKET=medscrita-audios

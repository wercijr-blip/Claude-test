# ── Banco de Dados ────────────────────────────────────────
DATABASE_URL=mysql://user:password@localhost:3306/medscribe

# ── Autenticação JWT ──────────────────────────────────────
# Gerar com: openssl rand -hex 32
JWT_SECRET=TROQUE_POR_STRING_ALEATORIA_DE_64_CHARS_MINIMO

# ── OpenAI (transcrição + SOAP + extração clínica) ───────
OPENAI_API_KEY=sk-...

# ── Anthropic (chat de evidências + insights admin) ───────
ANTHROPIC_API_KEY=sk-ant-...

# ── AWS S3 (Uploads de áudio) ─────────────────────────────
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=us-east-1
S3_BUCKET_NAME=medscribe-audios

# ── Email (SendGrid) ──────────────────────────────────────
SENDGRID_API_KEY=SG.xxx
BULLETIN_FROM_EMAIL=conhecimento@suaclinica.com.br
BULLETIN_FROM_NAME=MedScribe — Meu Conhecimento

# ── App ───────────────────────────────────────────────────
VITE_APP_ID=medscribe
MEDSCRIBE_URL=https://medscribe.suaclinica.com.br
MEDSCRIBE_CLINIC_NAME=Clínica Dr. Werciley
NODE_ENV=production
PORT=3000

# ── Redis / BullMQ ────────────────────────────────────────
REDIS_URL=redis://localhost:6379


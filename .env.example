# ── Banco de dados ────────────────────────────────────────────────────────────
DATABASE_URL=mysql://usuario:senha@host:4000/facilita_prep?ssl={"rejectUnauthorized":true}

# ── Autenticação OAuth + JWT ──────────────────────────────────────────────────
JWT_SECRET=gere_com_openssl_rand_hex_32_minimo_64_chars
GOOGLE_CLIENT_ID=seu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_google_client_secret
OWNER_OPEN_ID=sub_do_admin_principal_no_google

# ── Criptografia LGPD (AES-256-GCM) ──────────────────────────────────────────
# Gerar com: openssl rand -hex 32
ENCRYPTION_KEY=hex_64_chars_obrigatorio
CPF_HASH_SALT=string_minimo_32_chars_para_hash_cpf

# ── AWS S3 ────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=sa-east-1
AWS_S3_BUCKET=nome-do-bucket-s3

# ── E-mail (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Facilita PrEP <noreply@facilitaprep.com.br>

# ── Asaas (pagamentos) ────────────────────────────────────────────────────────
ASAAS_API_KEY=$aact_xxxxxxxxxxxx
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=string_secreta_para_validar_webhooks
CONSULTA_VALOR=150

# ── LLM (Análise de exames via IA) ───────────────────────────────────────────
BUILT_IN_FORGE_API_URL=https://api.anthropic.com
BUILT_IN_FORGE_API_KEY=sk-ant-api03-xxxx
LLM_DAILY_LIMIT=200

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Certificado ICP-Brasil ────────────────────────────────────────────────────
# Em produção (Railway): base64 do arquivo .pfx
# Gerar com: base64 -w 0 server/certs/cert.pfx
ICP_PFX_BASE64=
ICP_PFX_PASSWORD=senha_do_pfx

# ── WhatsApp (Z-API) ──────────────────────────────────────────────────────────
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
STAFF_WHATSAPP_MEDICOS=+5561999999999
STAFF_WHATSAPP_SECRETARIAS=+5561888888888

# ── Dados do Médico ───────────────────────────────────────────────────────────
MEDICO_NOME=Dr. Nome Completo
MEDICO_CRM=12345
MEDICO_CRM_UF=DF
SUS_CNES=9843744

# ── App ───────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=
PORT=3000
NODE_ENV=development

# ── Meta Conversions API (CAPI) ───────────────────────────────────────────────
META_PIXEL_ID=123456789012345
META_CAPI_TOKEN=EAAxxxxxxxxxx

# ── Sentry ────────────────────────────────────────────────────────────────────
SENTRY_DSN_SERVER=https://xxxx@o0000.ingest.sentry.io/0000
SENTRY_ENVIRONMENT=development

# ── TOTP 2FA ─────────────────────────────────────────────────────────────────
# Obrigatório quando há usuários com totpEnabled=true
# Gerar com: openssl rand -hex 32
TOTP_ENC_KEY=

# ── Endpoints de operação ─────────────────────────────────────────────────────
# Gerar com: openssl rand -hex 32 (mínimo 32 chars)
OPS_TOKEN=

# ── Feature flags ─────────────────────────────────────────────────────────────
ENABLE_DEBIT_CARD=false
WORKERS_ENABLED=true

# ============================================================
# Facilita PrEP — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env.
# ============================================================

# ── Banco de Dados (TiDB Cloud Serverless) ────────────────
# Obter em: https://tidbcloud.com → Connect → Node.js
DATABASE_URL=mysql://usuario:senha@gateway01.sa-east-1.prod.aws.tidbcloud.com:4000/facilita_prep?ssl={"rejectUnauthorized":true}

# ── Autenticação ──────────────────────────────────────────
# Mínimo 32 caracteres — gerar com: openssl rand -hex 32
JWT_SECRET=meu_jwt_secret_super_secreto_de_pelo_menos_32_chars_aqui

# Google OAuth — criar credenciais em: https://console.cloud.google.com → APIs & Services → Credentials
# Formato do Client ID: NNNNNNNNNNNN-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_ID=SEU_GOOGLE_CLIENT_ID_AQUI
GOOGLE_CLIENT_SECRET=SEU_GOOGLE_CLIENT_SECRET_AQUI

# OpenID (sub) do usuário admin principal — copiar do primeiro login Google
OWNER_OPEN_ID=123456789012345678901

# ── Criptografia LGPD ─────────────────────────────────────
# Chave AES-256 (exatamente 64 chars hex = 32 bytes) — gerar com: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Salt para hash de CPF — mínimo 32 caracteres — gerar com: openssl rand -hex 32
CPF_HASH_SALT=meu_salt_para_hash_de_cpf_de_pelo_menos_32_chars

# ── AWS S3 (Uploads de Exames) ────────────────────────────
# Região padrão: sa-east-1 (São Paulo)
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=sa-east-1
AWS_S3_BUCKET=facilita-prep-exames-producao

# ── E-mail (Resend) ───────────────────────────────────────
# Opcional — obter em: https://resend.com
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Remetente padrão (não alterar sem configurar domínio no Resend)
# EMAIL_FROM=Facilita PrEP <noreply@facilitaprep.com.br>

# ── Pagamentos (Asaas) ────────────────────────────────────
# Opcional — obter em: https://www.asaas.com → Configurações → API
# ASAAS_API_KEY=\$aact_exemplo_chave_api_asaas

# Ambiente Asaas: sandbox (dev/teste) ou production (produção real)
# ASAAS_ENV=sandbox

# Token para validar webhooks Asaas — gerar com: openssl rand -hex 32
# ASAAS_WEBHOOK_TOKEN=meu_webhook_token_asaas_aqui

# ── Valor da Consulta ─────────────────────────────────────
# Valor em reais da consulta PrEP. Alterável via Railway sem redeploy.
# CONSULTA_VALOR=150

# ── LLM (Anthropic Claude) ────────────────────────────────
# URL da API — padrão: https://api.anthropic.com
# BUILT_IN_FORGE_API_URL=https://api.anthropic.com

# Opcional, mas obrigatório para análise de exames e CIS
# BUILT_IN_FORGE_API_KEY=sk-ant-api03-EXEMPLO_CHAVE_ANTHROPIC

# ── Redis / BullMQ (Filas de PDF e Jobs) ──────────────────
# Padrão local: redis://localhost:6379
# Railway Redis: redis://default:senha@redis.railway.internal:6379
REDIS_URL=redis://localhost:6379

# ── Certificado ICP-Brasil (Assinatura Digital) ───────────
# Opcional — necessário para geração de PDFs com assinatura ICP-Brasil
# Gerar base64 com: base64 -w 0 certificado.pfx
# ICP_PFX_BASE64=AAAA...base64_do_arquivo_pfx...==
# ICP_PFX_PASSWORD=senha_do_certificado_pfx

# ── WhatsApp (Z-API) ──────────────────────────────────────
# Opcional — criar instância em: https://z-api.io → Dashboard → Instâncias
# ZAPI_INSTANCE_ID=sua_instance_id
# ZAPI_TOKEN=seu_token_zapi

# ── Dados do Médico ───────────────────────────────────────
# Todos com valores padrão; sobrescrever apenas se necessário
# MEDICO_NOME=Werciley Saraiva Vieira Junior
# MEDICO_CRM=16381
# MEDICO_CRM_UF=DF
# MEDICO_CRM_TIPO=CRM
# MEDICO_RQE=RQE 14486

# ── Dados da Clínica ──────────────────────────────────────
# CLINICA_NOME=ATOS Saúde Integrada Hospital Dia e Vacinas
# SUS_CNES=9843744

# ── URLs e CORS ───────────────────────────────────────────
# URL pública do app (usada em links de e-mail e redirecionamentos OAuth)
# APP_URL=https://www.facilitaprep.com.br

# Origens permitidas adicionais separadas por vírgula (opcional)
# ALLOWED_ORIGINS=https://parceiro.com.br,https://outro.com.br

# ── Servidor ──────────────────────────────────────────────
# Railway injeta PORT automaticamente; manter 3000 para desenvolvimento local
PORT=3000

# Ambiente: development, production ou test
NODE_ENV=development

# Desabilitar workers ao rodar serviço dedicado (server/workers.ts)
# WORKERS_ENABLED=true

# ── Sentry (Error Tracking) ───────────────────────────────
# Opcional — obter DSNs em: https://sentry.io → Settings → Projects
# SENTRY_DSN_SERVER=https://chave@o000000.ingest.sentry.io/0000000
# SENTRY_DSN_WEB=https://chave@o000000.ingest.sentry.io/0000001
# SENTRY_ENVIRONMENT=production

# ── TOTP 2FA ──────────────────────────────────────────────
# Opcional (exatamente 64 chars hex) — gerar com: openssl rand -hex 32
# TOTP_ENC_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── Métodos de Pagamento ──────────────────────────────────
# Habilitar cartão de débito via Asaas (desabilitado por padrão)
# ENABLE_DEBIT_CARD=false

# ── PubMed / NCBI ─────────────────────────────────────────
# Opcional — sem chave: 3 req/s; com chave: 10 req/s
# Obter em: https://www.ncbi.nlm.nih.gov/account/
# NCBI_API_KEY=sua_chave_ncbi_aqui

# ── Zotero (Biblioteca de Referências) ────────────────────
# Opcional — obter em: https://www.zotero.org/settings/keys
# ZOTERO_API_KEY=sua_chave_zotero_aqui
# ZOTERO_USER_ID=12345678

# ── Unpaywall (Texto Completo Open Access) ────────────────
# Opcional — gratuito; e-mail usado apenas para identificação na API
# UNPAYWALL_EMAIL=medico@exemplo.com.br

# ── Obsidian / GitHub (Publicação de Notas) ───────────────
# Opcional — Personal Access Token com escopo "repo"
# OBSIDIAN_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OBSIDIAN_GITHUB_REPO=usuario/nome-do-repo-obsidian

# ── n8n (Automações) ──────────────────────────────────────
# Opcional — URL base do n8n (local ou hospedado)
# N8N_WEBHOOK_URL=http://localhost:5678
# N8N_WEBHOOK_SECRET=meu_segredo_webhook_n8n

# ── REST API do CIS ───────────────────────────────────────
# Opcional — autenticação por API key para integrações externas (n8n, scripts)
# CIS_API_KEY deve ter pelo menos 32 caracteres — gerar com: openssl rand -hex 32
# CIS_API_KEY=minha_cis_api_key_com_pelo_menos_32_chars_aqui
# CIS_MEDICO_USER_ID=1

# ── Budget Diário Claude Opus ─────────────────────────────
# Limite de tokens Opus/dia (CIS). Quando atingido, chamadas fazem downgrade para Sonnet.
# Definir 0 para desabilitar o limite.
# OPUS_DAILY_TOKEN_BUDGET=100000

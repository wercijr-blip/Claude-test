# ============================================================
# Facilita PrEP — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env.
# ============================================================

# ── Banco de Dados (TiDB Cloud Serverless) ────────────────
# Obter em: https://tidbcloud.com → Connect → Node.js
DATABASE_URL=mysql://usuario:senha@gateway01.sa-east-1.prod.aws.tidbcloud.com:4000/facilita_prep?ssl={"rejectUnauthorized":true}

# ── Autenticação ──────────────────────────────────────────
# Mínimo 32 caracteres — gerar com: openssl rand -hex 32
JWT_SECRET=TROQUE_POR_STRING_ALEATORIA_DE_64_CHARS_MINIMO

# ── Criptografia LGPD ─────────────────────────────────────
# Chave AES-256 (64 chars hex = 32 bytes) — gerar com: openssl rand -hex 32
ENCRYPTION_KEY=TROQUE_POR_64_CHARS_HEX_AQUI_GERADO_COM_OPENSSL_RAND_HEX_32
# Salt para hash de CPF — gerar com: openssl rand -hex 32
CPF_HASH_SALT=TROQUE_POR_STRING_ALEATORIA_DE_32_CHARS_MINIMO

# ── Google OAuth ─────────────────────────────────────────
# Criar credenciais em: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=XXXXXXXXXX.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-XXXXXXXXXX
# O GOOGLE_CLIENT_ID é exposto ao frontend via endpoint /trpc/config.getPublicConfig
# (não é necessário VITE_GOOGLE_CLIENT_ID — o frontend busca em runtime)

# OpenID (sub) do usuário admin principal — copiar do primeiro login Google
OWNER_OPEN_ID=GOOGLE_SUB_DO_ADMIN

# ── AWS S3 (Uploads de Exames) ────────────────────────────
# Região recomendada: sa-east-1 (São Paulo)
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=sa-east-1
AWS_S3_BUCKET=facilita-prep-exames-producao

# ── E-mail ────────────────────────────────────────────────
# MVP: Gmail SMTP (habilitar "Senha de app" na conta Google)
GMAIL_USER=seu@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# Produção: Resend (https://resend.com)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ── FocusNFe (NFS-e) ──────────────────────────────────────
# Obter tokens em: https://focusnfe.com.br
FOCUSNFE_TOKEN_HOMOLOGACAO=token_homologacao_aqui
FOCUSNFE_TOKEN_PRODUCAO=token_producao_aqui
# Usar "homologacao" em desenvolvimento, "producao" apenas em produção real
FOCUSNFE_ENVIRONMENT=homologacao

# ── Stripe (Pagamentos) ───────────────────────────────────
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# ── WhatsApp (Z-API) ──────────────────────────────────────
# Criar instância em: https://z-api.io → Dashboard → Instâncias
ZAPI_INSTANCE_ID=SUA_INSTANCE_ID
ZAPI_TOKEN=SEU_TOKEN_ZAPI

# ── URL do App (usada nos links enviados ao paciente) ──────
APP_URL=https://facilitaprep.com.br

# ── LLM — Análise de Exames ───────────────────────────────
BUILT_IN_FORGE_API_URL=https://api.anthropic.com
BUILT_IN_FORGE_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# ── Redis / BullMQ (Filas de PDF) ─────────────────────────
# Upstash: https://console.upstash.com → Redis → Connect → Node.js
REDIS_URL=rediss://default:xxxxxxxxxxxx@xxxx.upstash.io:6379

# ── Porta do Servidor ─────────────────────────────────────
# Railway injeta PORT automaticamente; mantenha 3000 para local
PORT=3000

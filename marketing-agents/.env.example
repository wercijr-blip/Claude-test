# ─── ANTHROPIC ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── META / INSTAGRAM ────────────────────────────────────────────────────────
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ─── GOOGLE ADS ──────────────────────────────────────────────────────────────
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# ─── LINKEDIN ────────────────────────────────────────────────────────────────
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=
LINKEDIN_AD_ACCOUNT_ID=

# ─── GERAÇÃO DE IMAGENS ──────────────────────────────────────────────────────
# Ideogram v2 — primário (console.ideogram.ai → API Keys)
IDEOGRAM_API_KEY=
# DALL-E 3 via OpenAI — fallback (platform.openai.com → API Keys)
OPENAI_API_KEY=

# ─── GERAÇÃO DE VÍDEOS ───────────────────────────────────────────────────────
# HeyGen — avatar do Dr. Werciley falando (app.heygen.com → API Keys)
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=       # ID do avatar criado no HeyGen com foto/vídeo do Dr. Werciley
HEYGEN_VOICE_ID=        # ID da voz em português BR selecionada no HeyGen

# Runway Gen-3 — vídeos criativos/animados (app.runwayml.com → API Keys)
RUNWAY_API_KEY=

# ─── WHATSAPP BUSINESS API ───────────────────────────────────────────────────
# Mesmo META_ACCESS_TOKEN acima. Número gerenciado em business.facebook.com
WHATSAPP_PHONE_NUMBER_ID=   # ID do número no WhatsApp Business Manager

# ─── SENDGRID (e-mail marketing) ─────────────────────────────────────────────
# app.sendgrid.com → Settings → API Keys
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@facilitaprep.com.br

# ─── SIMULAÇÃO (true = não chama APIs reais, usa dados mock) ─────────────────
SIMULATION_MODE=true

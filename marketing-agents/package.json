{
  "name": "marketing-agents",
  "version": "1.0.0",
  "description": "Sistema de agentes de marketing IA para Facilita PrEP e Clínica IASO",
  "main": "dist/orchestrator.js",
  "scripts": {
    "start": "ts-node src/orchestrator.ts",
    "run-now": "ts-node src/orchestrator.ts --run-now",
    "report": "ts-node src/orchestrator.ts --report-only",
    "financial": "ts-node src/orchestrator.ts --financial",
    "build": "tsc",
    "dashboard": "npx serve src/dashboard -p 3001",
    "dev": "ts-node-dev --respawn src/orchestrator.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.3",
    "axios": "^1.7.2",
    "dotenv": "^16.4.5",
    "googleapis": "^144.0.0",
    "node-cron": "^3.0.3",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
